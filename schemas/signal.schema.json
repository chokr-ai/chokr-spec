{
  "$id": "https://spec.chokr.dev/schemas/signal/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "ext": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ext"
    },
    "facts": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Facts"
    },
    "guard": {
      "title": "Guard",
      "type": "string"
    },
    "latency_us": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Us"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "signal_id": {
      "title": "Signal Id",
      "type": "string"
    },
    "source": {
      "default": "guard",
      "enum": [
        "guard",
        "verifier"
      ],
      "title": "Source",
      "type": "string"
    },
    "suggested_modification": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Modification"
    }
  },
  "required": [
    "code",
    "confidence",
    "envelope_id",
    "guard",
    "schema_version",
    "severity",
    "signal_id"
  ],
  "title": "Signal",
  "type": "object"
}
